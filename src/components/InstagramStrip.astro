---
import Photo from './Photo.astro';
import { instagram } from '../data/frames';
import { strip, business } from '../data/site';

/*
	The strip that closes the page — eyebrow, handle, three photographs,
	the same slot the reference closes its pitch with. It was once one line
	at the tail of the gallery, which buried the only off-site path on the
	page under six photographs; it has been its own slot since.

	Three plates are here because three are what a closing strip holds:
	the chosen set widens the frame set instead of repeating it — the same
	rule the gallery follows, and every plate is shown exactly once per
	page it appears on (see the ledger in frames.ts). Bare photographs,
	no labels: the gallery labels places; a social strip is browsed, not
	read.
*/

const plates = [instagram.moon, instagram.tablesSet, instagram.rooftop] as const;
---

<section id="instagram" aria-labelledby="instagram-heading" class="pt-10 pb-20 md:pt-12 md:pb-28">
	<div class="shell">
		<div class="mx-auto flex max-w-2xl flex-col items-center text-center" data-reveal>
			<p class="eyebrow text-body">{strip.eyebrow}</p>
			<h2 id="instagram-heading" class="mt-4 font-display text-heading leading-[1.02] tracking-[-0.02em] text-balance">
				<a
					href={business.instagramUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="text-canyon-champagne transition-colors duration-300 hover:text-canyon-amber"
				>
					<span translate="no">@{business.instagram}</span>
				</a>
			</h2>
			<p class="mt-4 text-sm text-canyon-champagne/75">{strip.note}</p>
		</div>

		<ul class="mt-20 grid grid-cols-1 items-start gap-4 sm:grid-cols-3 md:mt-28 md:gap-5">
			{
				plates.map((frame, i) => (
					<li data-reveal style={`--reveal-delay:${i * 70}ms`}>
						<Photo
							src={frame.src}
							alt={frame.alt}
							ratio={frame.ratio}
							zoom
							widths={[400, 640, 900]}
							sizes="(min-width: 640px) 30vw, 92vw"
						/>
					</li>
				))
			}
		</ul>
	</div>
</section>
