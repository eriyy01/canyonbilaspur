---
import { Image } from 'astro:assets';
import { room } from '../data/frames';
import { events, contact, cta } from '../data/site';

/*
	Audit fix: this section used to render a gradient tile reading
	"EVENT PHOTOGRAPHY TO COME". Unfinished work, visible, on a page that is
	meant to take bookings.

	There is no event photography to wait for — the Sufi Night archive is a
	genuinely full house, and that is what a group is buying when they enquire,
	so those frames carry the section.

	The plates are 4:5 from the same Sufi Night post, so they are shown
	whole at that ratio. Two are carried here, side by side — the middle
	frame is retired, so the section stays a pair instead of a row.
*/
---

<section id="events" class="py-0">
	<div class="shell">
		<div class="grid items-start gap-10 md:grid-cols-12 md:gap-12">
			<div class="flex flex-col items-center text-center md:col-span-5 md:items-start md:text-left md:pt-3" data-reveal>
				<p class="eyebrow text-body" translate="no">{events.eyebrow}</p>
				<h2
					class="mt-4 max-w-sm font-display text-heading leading-[1.04] tracking-[-0.02em] text-balance text-canyon-champagne"
				>
					{events.body}
				</h2>

				<ul class="mt-8 w-full border-t border-canyon-coal/80">
					{
						events.details.map((detail) => (
							<li class="flex items-center gap-3 border-b border-canyon-coal/80 py-3.5 text-body text-canyon-champagne">
								<span class="h-1 w-1 shrink-0 rounded-full bg-canyon-amber" aria-hidden="true" />
								{detail}
							</li>
						))
					}
				</ul>

				<div class="mt-8 flex flex-col items-center gap-2.5 sm:flex-row">
					<button
						type="button"
						data-open-booking
						class="inline-flex min-h-[2.75rem] items-center justify-center gap-2.5 rounded-lg bg-canyon-amber px-6 text-sm font-semibold text-canyon-void transition-[filter] duration-300 hover:brightness-110"
					>
						{cta.events}
					</button>
					<a
						href={`https://wa.me/${contact.whatsapp}`}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex min-h-[2.75rem] items-center justify-center gap-2 rounded-lg border border-canyon-coal px-6 text-sm font-medium text-canyon-champagne transition-colors duration-300 hover:border-canyon-amber/60 hover:text-canyon-amber"
					>
						WhatsApp
					</a>
				</div>
			</div>

			{/* Two plates, side by side. Ratios are the plates' own. */}
			<div class="grid grid-cols-2 gap-4 md:col-span-7 md:gap-5">
				{
					[{ shot: room.guests }, { shot: room.band }].map(({ shot }, i) => (
						<figure data-reveal style={`--reveal-delay:${i * 70}ms`}>
							<Image
								src={shot.src}
								alt={shot.alt}
								widths={[420, 640, 900]}
								sizes="(min-width: 768px) 28vw, 48vw"
								format="avif"
								loading="lazy"
								class={`w-full rounded-shell bg-canyon-ember object-cover ${shot.ratio}`}
							/>
						</figure>
					))
				}
			</div>
		</div>
	</div>
</section>