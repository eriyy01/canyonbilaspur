---
import { Image } from 'astro:assets';
import { kitchen, bar } from '../data/frames';
import { cuisine, contact, cta } from '../data/site';

/*
	A menu board, not a menu.

	No prices have ever been published on Canyon's account, so there are none
	here. The previous build filled four cards with dish names in body-weight
	sans and a meaningless "02 / 03" counter in the corner. This is the same
	information set as a typeset menu: four categories, the dishes actually
	photographed on their own reels, hairline rules, tabular rhythm, and the
	price list routed to a phone number where it belongs.

	It is set on the venue's own ochre plaster tone rather than the standard
	near-black surface, which is what makes it read as a menu instead of a
	list of cards.
*/
---

<section id="cuisine" class="pt-16 pb-0 md:pt-20 md:pb-0">
	<div class="shell">
		<div class="grid gap-8 md:grid-cols-12 md:gap-10">
			<div class="flex flex-col md:col-span-5" data-reveal>
				<h2
					class="max-w-md font-display text-heading leading-[1.04] tracking-[-0.02em] text-balance text-canyon-champagne"
				>
					Multicuisine, and no rush.
				</h2>

				<p class="mx-auto mt-6 max-w-sm text-center text-lede text-canyon-champagne/85 md:mx-0 md:text-left">
					Italian, Asian and grill off one kitchen. Dietary requirements and the
					current price list are a phone call away. We don't publish a list that
					goes stale.
				</p>

				{/*
					Dinner plus a second table frame, side by side. The dinner
					plate is a 9:16 reel, not a 4:5 post, and Canyon set its
					headline as a vertical column down the middle of it. In a 4:5
					box the column was cut in half and the words "the best Dinner"
					were lost entirely — which is a shame, because that sentence
					is the best thing they ever wrote about the kitchen. So both
					plates are boxed at 9:16 and shown whole. See the note on
					`kitchen.dinner` in src/data/frames.ts.
				*/}
				<div class="mt-8 grid grid-cols-2 items-start gap-4 md:mt-auto md:pt-8">
					<figure>
						<Image
							src={kitchen.dinner.src}
							alt={kitchen.dinner.alt}
							widths={[320, 480, 640, 800]}
							sizes="(min-width: 768px) 18vw, 44vw"
							format="avif"
							loading="lazy"
							class={`${kitchen.dinner.ratio} w-full rounded-shell bg-canyon-ember object-cover`}
						/>
					</figure>
					<figure>
						<Image
							src={bar.drinks.src}
							alt={bar.drinks.alt}
							widths={[320, 480, 640]}
							sizes="(min-width: 768px) 18vw, 44vw"
							format="avif"
							loading="lazy"
							class={`${bar.drinks.ratio} w-full rounded-shell bg-canyon-ember object-cover`}
						/>
					</figure>
				</div>
			</div>

			{/* The board */}
			<div class="md:col-span-7" data-reveal style="--reveal-delay:90ms">
				<div class="rounded-shell border border-canyon-ochre/40 bg-canyon-ochre/[0.12] p-6 shadow-[0_1px_2px_rgba(43,33,24,0.06)] md:p-9">
					<div class="flex items-baseline justify-between gap-4 pb-4">
						<p class="font-display text-lede tracking-[-0.01em] text-canyon-champagne">
							What we cook
						</p>
						<p class="eyebrow">
							Kitchen
						</p>
					</div>

					<div class="grid gap-x-8 gap-y-8 sm:grid-cols-2">
						{
							cuisine.map((category) => (
								<div class="pt-6">
									<h3 class="eyebrow">{category.title}</h3>
									<ul class="mt-4">
										{category.dishes.map((dish) => (
											<li class="flex items-baseline justify-between gap-3 py-2.5">
												<span class="font-display text-lede leading-snug tracking-[-0.01em] text-canyon-champagne/95" translate="no">
													{dish}
												</span>
											</li>
										))}
									</ul>
								</div>
							))
						}
					</div>

					<p class="mt-8 text-sm leading-relaxed text-canyon-champagne/85">
						Dishes are pulled from what's been served and photographed on our own
						reels. The full menu, prices and dietary requirements:
						<a
							href={`tel:${contact.tel}`}
							class="font-medium text-canyon-amber underline decoration-canyon-amber/40 underline-offset-4 transition-colors hover:decoration-canyon-amber"
						>
							{cta.kitchen}
						</a>
					</p>
				</div>
			</div>
		</div>
	</div>
</section>