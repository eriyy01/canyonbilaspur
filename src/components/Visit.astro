---
import Section from './Section.astro';
import { business, contact, visit } from '../data/site';

/** One ruled ledger panel; rows split by hairlines. On sm+ the label sits
 *  left with its action link under it, the value right of the label column */
const label =
	'text-body font-medium tracking-[0.16em] text-canyon-amber uppercase';
const link =
	'group mt-4 inline-flex min-h-[2.75rem] items-center gap-2 text-sm font-medium text-canyon-amber transition-colors duration-300 hover:text-canyon-champagne sm:mt-0';
const arrow = 'h-3.5 w-3.5';

/**
 * `intro=false` for the /visit page, where PageHead already carries the
 * visit heading as the h1 — the ledger rows and map are the section's work,
 * not a second heading. `true` for the home page, which has no PageHead.
 */
interface Props {
	intro?: boolean;
}

const { intro = true } = Astro.props;
---

<Section
	id="visit"
	eyebrow={intro ? visit.eyebrow : undefined}
	heading={intro ? visit.heading : undefined}
	eyebrowClass="eyebrow text-body"
	headingClass="mt-4 font-display text-heading leading-[1.02] tracking-[-0.02em] text-balance text-canyon-champagne"
>
	<div class="mt-10 overflow-hidden rounded-shell border border-canyon-coal/70 bg-canyon-ember" data-reveal>
		<div class="grid gap-x-8 gap-y-1 p-6 sm:grid-cols-[1fr_auto] sm:items-center md:p-8">
				<p class={label}>Address</p>
				<address class="mt-3 text-blurb text-canyon-champagne not-italic">
					{business.address.line1}<br />
					{business.address.line2}
				</address>
				<a href={contact.mapsUrl} target="_blank" rel="noopener noreferrer" class={link}>
					Open in Maps
					<svg
						class={arrow}
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2.25"
						stroke-linecap="round"
						aria-hidden="true"
					>
						<path d="M7 17L17 7M9 7h8v8" />
					</svg>
				</a>
		</div>
		<div class="grid gap-x-8 gap-y-1 border-t border-canyon-coal/70 p-6 sm:grid-cols-[1fr_auto] sm:items-center md:p-8">
				<p class={label}>Reservations</p>
				<p class="mt-3 font-display text-quote tracking-[-0.02em] tabular-nums whitespace-nowrap text-canyon-champagne">
					{contact.telDisplay}
				</p>
				<a href={`tel:${contact.tel}`} class={link}>
					Call
					<svg
						class={arrow}
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2.25"
						stroke-linecap="round"
						aria-hidden="true"
					>
						<path d="M7 17L17 7M9 7h8v8" />
					</svg>
				</a>
		</div>
		<div class="grid gap-x-8 gap-y-1 border-t border-canyon-coal/70 p-6 sm:grid-cols-[1fr_auto] sm:items-center md:p-8">
				<p class={label}>Events &amp; groups</p>
				<p class="mt-3 font-display text-quote tracking-[-0.02em] tabular-nums whitespace-nowrap text-canyon-champagne">
					{contact.resDisplay}
				</p>
				<a href={`tel:${contact.resTel}`} class={link}>
					Call
					<svg
						class={arrow}
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2.25"
						stroke-linecap="round"
						aria-hidden="true"
					>
						<path d="M7 17L17 7M9 7h8v8" />
					</svg>
				</a>
		</div>
	</div>

	{/*
		Hours are genuinely unknown — closing time has never been published,
		so nothing claims it. The closer is their own line from the tour
		post: the maps are shown and the route found — "come see it for
		yourself." This section lives only on /visit (see pages/index for
		the home flow), so `intro` gates the section heading, not this
		note.
	*/}
	<div class="mt-6 overflow-hidden rounded-shell border border-canyon-coal/70 bg-canyon-void/40 p-1.5" data-reveal>
		<iframe
			title="Map to Canyon at Hotel Intercity International, Jagmal Chowk, Bilaspur"
			src="https://www.google.com/maps?q=Hotel%20Intercity%20International%20Jagmal%20Chowk%20Bilaspur&output=embed"
			class="h-64 w-full rounded-core md:h-72"
			loading="lazy"
			referrerpolicy="no-referrer-when-downgrade"
			allowfullscreen
		></iframe>
	</div>
	<p class="mx-auto mt-10 -mb-10 max-w-md text-center text-blurb text-canyon-champagne/85 md:mx-0 md:-mb-14 md:text-left" data-reveal>
		{visit.note}
	</p>
</Section>