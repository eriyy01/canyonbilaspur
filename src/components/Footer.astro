---
import { business, contact, navigation } from '../data/site';
import { Image } from 'astro:assets';
import CanyonMark from './CanyonMark.astro';
import canyonLogo from '../assets/canyon-logo-gold.png';
---

<footer class="border-t border-canyon-coal">
	<div class="shell py-12">
		<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
			<div>
				<p class="flex items-center gap-2.5">
					<CanyonMark class="w-10 shrink-0" tone="amber" />
					<Image
						src={canyonLogo}
						alt="Canyon"
						width={256}
						densities={[1, 2]}
						class="h-auto w-32 shrink-0 translate-y-[5px]"
					/>
				</p>
				<p class="mt-3 text-base text-canyon-champagne/85">{business.tagline}</p>
			</div>

			<div>
				<p class="text-xs font-semibold tracking-[0.18em] text-canyon-amber uppercase">
					Explore
				</p>
				<ul class="mt-4 space-y-2 text-base">
					{
						navigation.map((item) => (
							<li>
								<a
									href={item.href}
									aria-current={Astro.url.pathname === item.href ? 'page' : undefined}
									class="inline-block py-2.5 text-canyon-champagne/85 transition-colors duration-300 hover:text-canyon-champagne"
								>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<p class="text-xs font-semibold tracking-[0.18em] text-canyon-amber uppercase">
					Contact
				</p>
				{/* Owner-directed: the label sits a little closer to the address
					than the link columns' label-to-list gap — a column of tappable
					links wants its air, a plain address doesn't. */}
				<ul class="mt-2 space-y-2 text-base">
					<li class="text-canyon-champagne/85">
						{business.address.line1}<br />
						{business.address.line2}
					</li>
					<li>
						<a
							href={`tel:${contact.tel}`}
							class="inline-block py-2.5 text-canyon-champagne/85 tabular-nums transition-colors hover:text-canyon-champagne"
						>
							+91 {contact.telDisplay}
						</a>
					</li>
				</ul>
			</div>

			<div>
				<p class="text-xs font-semibold tracking-[0.18em] text-canyon-amber uppercase">
					Timing
				</p>
				<p class="mt-4 text-base text-canyon-champagne/85">
					Live music {business.eventStart}
				</p>
			</div>
		</div>

		<div
			class="mt-10 flex flex-col gap-4 border-t border-canyon-coal pt-6 text-base text-canyon-champagne/85 sm:flex-row sm:items-center sm:justify-between"
		>
			<p>&copy; {new Date().getFullYear()} <span translate="no">{business.name}</span>. All rights reserved.</p>
			<div class="flex flex-wrap items-center gap-x-5 gap-y-3">
				<a
					href={contact.mapsUrl}
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Canyon on Google Maps"
					class="inline-flex min-h-[2.75rem] items-center gap-2 text-canyon-champagne/85 transition-colors duration-300 hover:text-canyon-champagne"
				>
					<svg
						class="h-5 w-5"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path
							d="M20 10c0 4.99-5.54 10.19-7.4 11.8a1 1 0 0 1-1.2 0C9.54 20.19 4 14.99 4 10a8 8 0 0 1 16 0"
						></path>
						<circle cx="12" cy="10" r="3"></circle>
					</svg>
					<span translate="no">Google Maps</span>
				</a>
				<a
					href={business.instagramUrl}
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Canyon on Instagram @canyonbilaspur"
					class="inline-flex min-h-[2.75rem] items-center gap-2 text-canyon-champagne/85 transition-colors duration-300 hover:text-canyon-amber"
				>
					<svg
						class="h-5 w-5"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<rect x="3" y="3" width="18" height="18" rx="5" />
						<circle cx="12" cy="12" r="4" />
						<circle cx="17.2" cy="6.8" r="0.75" fill="currentColor" stroke="none" />
					</svg>
					<span translate="no">@{business.instagram}</span>
				</a>
			</div>
		</div>
		<p class="mt-8 text-center text-sm text-canyon-champagne/60">
			Designed &amp; built by <span translate="no" class="font-medium text-canyon-champagne/85">WexperBuilds</span>
		</p>
	</div>
</footer>