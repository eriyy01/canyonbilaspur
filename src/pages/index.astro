---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Nights from '../components/Nights.astro';
import Features from '../components/Features.astro';
import Tour from '../components/Tour.astro';
import CelebrateTeaser from '../components/CelebrateTeaser.astro';
import Kitchen from '../components/Kitchen.astro';
import ReserveBand from '../components/ReserveBand.astro';
import InstagramStrip from '../components/InstagramStrip.astro';
import Footer from '../components/Footer.astro';
import BookingModal from '../components/BookingModal.astro';
---

{/*
	HOME — the pitch. The reference flow (openhousecafe.in): hero + info
	strip, the signature nights, the four feature cards, the room walked by
	Tour, the celebration setups (short, with a hand-off to the full page),
	kitchen board, reservation band, instagram strip, footer.

	The room (gallery), the occasions in full (celebrate), the food in
	context (kitchen) and the practical page (visit) live on their own
	routes — see `navigation` in src/data/site.ts. The #nights and
	#instagram ids still name in-page landmarks on this route, scrolled
	past the sticky bar by the global scroll-padding.
*/}
<Layout>
	<Nav />

	<main id="main" class="relative z-10">
		<Hero />
		<Nights />
		<Features />
		<Tour />
		<CelebrateTeaser />
		<Kitchen />
		<ReserveBand />
		<InstagramStrip />
	</main>

	<Footer />
	<BookingModal />
</Layout>
