---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHead from '../components/PageHead.astro';
import Photo from '../components/Photo.astro';
import Setups from '../components/Setups.astro';
import Footer from '../components/Footer.astro';
import BookingModal from '../components/BookingModal.astro';
import { pages, celebrate, contact, cta } from '../data/site';
import { tonight } from '../data/frames';
---

{/*
	/celebrate — the page the owner's own five photographs exist for. The
	h1 is the line Canyon printed on their own artwork; the setups speak
	first, then the formats they publish, then the two ways to ask for
	one: the booking line printed on their Sufi poster, and the general
	line's WhatsApp.
*/}
<Layout title={pages.celebrate.title} description={pages.celebrate.description}>
	<Nav />

	<main id="main" class="relative z-10 pb-20 md:pb-28">
		<PageHead eyebrow={celebrate.eyebrow} title={celebrate.heading} lede={celebrate.lede} />

		<section class="pt-16 pb-20 md:pt-20 md:pb-28">
			<div class="shell">
				<Setups />
			</div>
		</section>

		<section aria-labelledby="formats-heading">
			<div class="shell">
				<div class="grid items-center gap-10 md:grid-cols-12 md:gap-12">
					<div class="flex flex-col items-center text-center md:col-span-5 md:items-start md:text-left" data-reveal>
						<p class="eyebrow text-body">{celebrate.formatsHeading}</p>
						<h2
							id="formats-heading"
							class="mt-4 font-display text-heading leading-[1.04] tracking-[-0.02em] text-balance text-canyon-champagne"
						>
							{celebrate.changeLine}
						</h2>

						<ul class="mt-8 w-full max-w-sm border-t border-canyon-coal/80">
							{
								celebrate.formats.map((format) => (
									<li class="flex items-center gap-3 border-b border-canyon-coal/80 py-3.5 text-body text-canyon-champagne">
										<span class="h-1 w-1 shrink-0 rounded-full bg-canyon-amber" aria-hidden="true" />
										{format}
									</li>
								))
							}
						</ul>
						<p class="mt-4 text-sm text-canyon-champagne/75">{celebrate.note}</p>

						<div class="mt-8 flex flex-col flex-wrap items-center gap-2.5 sm:flex-row">
							<button
								type="button"
								data-open-booking
								class="inline-flex min-h-[2.75rem] items-center justify-center whitespace-nowrap rounded-lg bg-canyon-amber px-6 text-sm font-semibold text-canyon-void transition-[filter] duration-300 hover:brightness-110"
							>
								{celebrate.callToAction}
							</button>
							<a
								href={`tel:${contact.resTel}`}
								class="inline-flex min-h-[2.75rem] items-center justify-center whitespace-nowrap rounded-lg border border-canyon-coal px-6 text-sm font-medium tabular-nums text-canyon-champagne transition-colors duration-300 hover:border-canyon-amber/60 hover:text-canyon-amber"
							>
								{cta.celebrateCall} on {contact.resDisplay}
							</a>
						</div>
					</div>

					<div class="md:col-span-7" data-reveal style="--reveal-delay:90ms">
						<Photo
							src={tonight.remember.src}
							alt={tonight.remember.alt}
							ratio={tonight.remember.ratio}
							zoom
							widths={[480, 640, 900, 1200]}
							sizes="(min-width: 768px) 58vw, 92vw"
						/>
						<p class="mt-3 text-center text-sm tracking-wide text-canyon-champagne/85 md:text-left" translate="no">
							“{tonight.remember.line}”
						</p>
					</div>
				</div>
			</div>
		</section>
	</main>

	<Footer />
	<BookingModal />
</Layout>
